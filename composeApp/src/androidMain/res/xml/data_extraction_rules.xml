<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (android:dataExtractionRules): same targeted exclusion for cloud
     backup AND device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="tazzzo_secure_auth.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="tazzzo_secure_auth.xml" />
    </device-transfer>
</data-extraction-rules>
