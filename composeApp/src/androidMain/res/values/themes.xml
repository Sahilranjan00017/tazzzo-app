<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      Android 12+ shows a system splash before Compose renders. It is the FIRST brand frame, so it uses the
      new identity only: the green tz mark (ic_splash_mark) on the cream window colour, which hands over to
      the in-app Splash (green tazzzo wordmark on cream) without a jump in colour, background or identity.
    -->
    <style name="Theme.Tazzzo.Splash" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowSplashScreenBackground" tools:targetApi="s">@color/taz_cream</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="s">@drawable/ic_splash_mark</item>
        <item name="android:windowBackground">@color/taz_cream</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
