<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      Android 12+ shows a system splash before Compose renders. Without this,
      the OS falls back to the default launcher placeholder — which is exactly
      the generic robot the app was showing. Branding it here makes the system
      splash and the in-app splash read as one continuous moment.
    -->
    <style name="Theme.Tazzzo.Splash" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowSplashScreenBackground" tools:targetApi="s">@color/taz_cream</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="s">@drawable/ic_launcher_foreground</item>
        <item name="android:windowBackground">@color/taz_cream</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
